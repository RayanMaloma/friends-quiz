# Supabase project → Project Settings → API (or "API Keys")
# Public (safe in the browser): used only for Realtime broadcast pings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — never expose. Used by the Next.js API routes for all DB access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
