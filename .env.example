# Supabase project → Project Settings → API (or "API Keys")
# Public (safe in the browser): used only for Realtime broadcast pings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — never expose. Used by the Next.js API routes for all DB and Storage access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# SERVER ONLY — password for the admin dashboard (/admin) and for opening a room on the TV.
# Required in production. Local dev without it falls back to "admin".
ADMIN_PASSWORD=choose-a-long-password

# Optional, local dev only: "1" ignores Supabase and uses the embedded database in .local-db/
# NEXT_PUBLIC_FQ_LOCAL_DB=1

# Optional, SERVER ONLY — the Mafia narrator's voice on the TV (lib/server/tts.ts).
# Without it the TV uses recorded lines (public/mafia/voice), then a system Arabic voice.
# ElevenLabs: pick a male Saudi Najdi voice from the voice library and paste its id.
# MAFIA_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Or Azure Speech (ar-SA-HamedNeural: Saudi male, closer to formal Arabic than Najdi):
# MAFIA_TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=ar-SA-HamedNeural
# Shown in the TV's sound settings, e.g. "راوي نجدي (ElevenLabs)":
# MAFIA_TTS_LABEL=
